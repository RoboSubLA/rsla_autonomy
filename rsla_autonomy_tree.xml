<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="Main">
  <BehaviorTree ID="Octagon">
    <Sequence>
      <GoToPose rel="0"
                mask="4"
                eulers="0;0;0"
                position="0;0;1"/>
      <Sleep msec="3000"/>
      <GoAtWrench mask="32"
                  torque="0;0;3"
                  force="0;0;0"/>
      <RetryUntilSuccessful num_attempts="-1">
        <Sequence>
          <WaitForFrontVision/>
          <FrontHaveSeenObjectSince timeout="500" class="6"/>
        </Sequence>
      </RetryUntilSuccessful>
      <GoAtWrench mask="33"
                  torque="0;0;0"
                  force="10;0;0"/>
      <RetryUntilSuccessful num_attempts="-1">
        <Sequence>
          <WaitForFrontVision/>
          <TurnTowardsObject fraction="0.75"
                             class="6"/>
          <Inverter>
            <FrontHaveSeenObjectSince timeout="1000"
                                 class="6"/>
          </Inverter>
        </Sequence>
      </RetryUntilSuccessful>
      <HoldPosition/>
      <Sleep msec="5000"/>
      <GoToPose rel="0"
                mask="32"
                eulers="0;0;0"
                position="0;0;0"/>
      <Sleep msec="5000"/>
    </Sequence>
  </BehaviorTree>
  <BehaviorTree ID="Bin">
    <Sequence>
      <GoToPose rel="0"
                mask="4"
                eulers="0;0;0"
                position="0;0;1.4"/>
      <Sleep msec="3000"/>
      <GoAtWrench mask="32"
                  torque="0;0;3"
                  force="0;0;0"/>
      <RetryUntilSuccessful num_attempts="-1">
        <Sequence>
          <WaitForFrontVision/>
          <FrontHaveSeenObjectSince timeout="500" class="6"/>
        </Sequence>
      </RetryUntilSuccessful>
      <GoAtWrench mask="33"
                  torque="0;0;0"
                  force="15;0;0"/>
      <RetryUntilSuccessful num_attempts="-1">
        <Sequence>
          <WaitForFrontVision/>
          <TurnTowardsObject fraction="0.75"
                             class="6"/>
          <Inverter>
            <FrontHaveSeenObjectSince timeout="1000"
                                 class="6"/>
          </Inverter>
        </Sequence>
      </RetryUntilSuccessful>
      <HoldPosition/>
      <Sleep msec="3000"/>
      <ForceSuccess>
        <Timeout msec="5000">
          <Repeat num_cycles="-1">
            <Sequence>
              <WaitForDownVision/>
              <AlignAboveObject class="6"
                                x_offset="0"
                                y_offset="0"
                                k_p="1"/>
            </Sequence>
          </Repeat>
        </Timeout>
      </ForceSuccess>
      <HoldPosition/>
      <Sleep msec="3000"/>
      <DropBall data="1"/>
      <Sleep msec="3000"/>
      <DropBall data="2"/>
      <sleep msec="3000"/>
      <DropBall data="0"/>
      <Sleep msec="5000"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Gate">
    <Sequence>
      <GoToPose rel="0"
                mask="4"
                eulers="0;0;0"
                position="0;0;0.8"/>
      <Sleep msec="10000"/>
      <GoAtWrench mask="32"
                  torque="0;0;5"
                  force="0;0;0"/>
      <RetryUntilSuccessful num_attempts="-1">
        <Sequence>
          <WaitForFrontVision/>
          <FrontHaveSeenObjectSince timeout="500"
                               class="4"/>
        </Sequence>
      </RetryUntilSuccessful>
      <GoAtWrench mask="33"
                  torque="0;0;0"
                  force="15;0;0"/>
      <RetryUntilSuccessful num_attempts="-1">
        <Sequence>
          <WaitForFrontVision/>
          <TurnTowardsObject fraction="0.75"
                             class="4"/>
          <Inverter>
            <FrontHaveSeenObjectSince timeout="3000"
                                 class="4"/>
          </Inverter>
        </Sequence>
      </RetryUntilSuccessful>
      <Sleep msec="3000"/>
      <HoldPosition/>
      <Sleep msec="5000"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Main">
    <Sequence name="root_sequence">
      <SubTree ID="Startup"/>
      <Sleep msec="5000"/>
      <SubTree ID="Gate"/>
      <SubTree ID="With_Style"/>
      <SubTree ID="Slalom"/>
      <SubTree ID="Bin"/>
      <SubTree ID="Octagon"/>
      <SubTree ID="Shutdown"
               _autoremap="false"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Shutdown">
    <SetArmedState flag="0"/>
  </BehaviorTree>

  <BehaviorTree ID="Slalom">
    <Sequence>
      <GoToPose rel="0"
                mask="4"
                eulers="0;0;0"
                position="0;0;1.3"/>
      <Sleep msec="5000"/>
      <GoAtWrench mask="32"
                  torque="0;0;-3"
                  force="0;0;0"/>
      <RetryUntilSuccessful num_attempts="-1">
        <Sequence>
          <WaitForFrontVision/>
          <FrontHaveSeenObjectSince timeout="500" class="6"/>
          <FrontHaveSeenObjectSince timeout="500" class="2" />
        </Sequence>
      </RetryUntilSuccessful>
      <GoAtWrench mask="33"
                  torque="0;0;0"
                  force="7;0;0"/>
      <RetryUntilSuccessful num_attempts="-1">
      	<Sequence>
          <WaitForFrontVision/>
          <OrientTowardsSlalom white_id="6"
                               red_id="2"
                               gate_type="2"
                               shift_force="7"
		                           fraction="0.75"/>
          <Inverter>
            <Sequence>
              <FrontHaveSeenObjectSince timeout="3000" class="2"/>
              <FrontHaveSeenObjectSince timeout="3000" class="6"/>
            </Sequence>
          </Inverter>
        </Sequence>
      </RetryUntilSuccessful>
      <Sleep msec="5000"/>
      <HoldPosition/>
      <Sleep msec="5000"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Startup">
    <Sequence>
      <PrintToLog message="Disarming..."/>
      <SetArmedState flag="0"/>
      <Sleep msec="5000"/>
      <CalibrateSurface/>
      <Sleep msec="1000"/>
      <WaitForPose/>
      <HoldPosition/>
      <Sleep msec="1000"/>
      <PrintToLog message="Arming!"/>
      <SetArmedState flag="1"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="With_Style">
    <Sequence>
      <GoToPose rel="1"
                mask="32"
                eulers="0;0;-45"
                position="0;0;0"/>
      <Sleep msec="2000"/>
      <Repeat num_cycles="8">
        <Sequence>
          <GoToPose rel="1"
                    mask="32"
                    eulers="0;0;90"
                    position="0;0;0"/>
          <Sleep msec="2000"/>
        </Sequence>
      </Repeat>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
        <Action ID="AlignAboveObject">
            <input_port name="k_p" type="float"/>
            <input_port name="x_offset" type="float"/>
            <input_port name="y_offset" type="float"/>
            <input_port name="class" type="unsigned char"/>
        </Action>
        <Action ID="CalibrateSurface"/>
        <Condition ID="DownCanSeeObject">
            <input_port name="class" type="unsigned char"/>
        </Condition>
        <Condition ID="DownHaveSeenObject">
            <input_port name="class" type="unsigned char"/>
        </Condition>
        <Condition ID="DownHaveSeenObjectSince">
            <input_port name="timeout" type="unsigned int"/>
            <input_port name="class" type="unsigned char"/>
        </Condition>
        <Condition ID="DownObjectCloserThan">
            <input_port name="distance" type="float"/>
            <input_port name="class" type="unsigned char"/>
        </Condition>
        <Action ID="DropBall">
            <input_port name="data" type="signed char"/>
        </Action>
        <Condition ID="FrontCanSeeObject">
            <input_port name="class" type="unsigned char"/>
        </Condition>
        <Condition ID="FrontHaveSeenObject">
            <input_port name="class" type="unsigned char"/>
        </Condition>
        <Condition ID="FrontHaveSeenObjectSince">
            <input_port name="timeout" type="unsigned int"/>
            <input_port name="class" type="unsigned char"/>
        </Condition>
        <Condition ID="FrontObjectCloserThan">
            <input_port name="distance" type="float"/>
            <input_port name="class" type="unsigned char"/>
        </Condition>
        <Action ID="GoAtWrench">
            <input_port name="mask" type="unsigned char"/>
            <input_port name="torque" type="geometry_msgs::msg::Vector3_&lt;std::allocator&lt;void&gt; &gt;"/>
            <input_port name="force" type="geometry_msgs::msg::Vector3_&lt;std::allocator&lt;void&gt; &gt;"/>
        </Action>
        <Action ID="GoToPose">
            <input_port name="rel" type="bool"/>
            <input_port name="mask" type="unsigned char"/>
            <input_port name="eulers" type="geometry_msgs::msg::Vector3_&lt;std::allocator&lt;void&gt; &gt;"/>
            <input_port name="position" type="geometry_msgs::msg::Vector3_&lt;std::allocator&lt;void&gt; &gt;"/>
        </Action>
        <Action ID="HoldPosition"/>
        <Action ID="OrientTowardsSlalom">
            <input_port name="fraction" type="float"/>
            <input_port name="gate_type" type="unsigned char"/>
            <input_port name="red_id" type="unsigned char"/>
            <input_port name="shift_force" type="float"/>
            <input_port name="white_id" type="unsigned char"/>
        </Action>
        <Action ID="PrintToLog">
            <input_port name="message" type="std::string"/>
        </Action>
        <Action ID="SetArmedState">
            <input_port name="flag" type="bool"/>
        </Action>
        <Action ID="TurnTowardsObject">
            <input_port name="fraction" type="float"/>
            <input_port name="class" type="unsigned char"/>
        </Action>
        <Action ID="WaitForDownVision"/>
        <Action ID="WaitForFrontVision"/>
        <Action ID="WaitForPose"/>
    </TreeNodesModel>
</root>
