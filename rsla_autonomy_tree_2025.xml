<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="Main">
  <BehaviorTree ID="Bin">
    <Sequence>
      <GoToPose rel="0"
                mask="4"
                eulers="0;0;0"
                position="0;0;0.5"/>
      <GoAtWrench mask="32"
                  torque="0;0;5"
                  force="0;0;0"/>
      <RetryUntilSuccessful num_attempts="-1">
        <Sequence>
          <WaitForFrontVision/>
          <FrontCanSeeObject class="6"/>
        </Sequence>
      </RetryUntilSuccessful>
      <GoAtWrench mask="33"
                  torque="0;0;0"
                  force="15;0;0"/>
      <RetryUntilSuccessful num_attempts="-1">
        <Sequence>
          <WaitForFrontVision/>
          <TurnTowardsObject fraction="0.75"
                             class="6"/>
          <Inverter>
            <FrontHaveSeenObjectSince timeout="3000"
                                 class="6"/>
          </Inverter>
        </Sequence>
      </RetryUntilSuccessful>
      <Sleep msec="3000"/>
      <GoToPose rel="0"
                mask="32"
                eulers="0;0;0"
                position="0;0;0"/>
      <Sleep msec="5000"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Gate">
    <Sequence>
      <GoToPose rel="0"
                mask="4"
                eulers="0;0;0"
                position="0;0;1"/>
      <Sleep msec="15000"/>
      <GoAtWrench mask="32"
                  torque="0;0;5"
                  force="0;0;0"/>
      <RetryUntilSuccessful num_attempts="-1">
        <Sequence>
          <WaitForFrontVision/>
          <FrontHaveSeenObjectSince timeout="500"
                               class="5"/>
        </Sequence>
      </RetryUntilSuccessful>
      <GoAtWrench mask="33"
                  torque="0;0;0"
                  force="15;0;0"/>
      <RetryUntilSuccessful num_attempts="-1">
        <Sequence>
          <WaitForFrontVision/>
          <TurnTowardsObject fraction="0.75"
                             class="5"/>
          <Inverter>
            <FrontHaveSeenObjectSince timeout="3000"
                                 class="5"/>
          </Inverter>
        </Sequence>
      </RetryUntilSuccessful>
      <Sleep msec="10000"/>
      <HoldPosition/>
      <Sleep msec="5000"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Main">
    <Sequence name="root_sequence">
      <SubTree ID="Startup"/>
      <Sleep msec="5000"/>
      <SubTree ID="Gate"/>
      <SubTree ID="With_Style"/>
      <SubTree ID="Slalom"/>
      <SubTree ID="Shutdown"
               _autoremap="false"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Shutdown">
    <SetArmedState flag="0"/>
  </BehaviorTree>

  <BehaviorTree ID="Slalom">
    <Sequence>
      <GoToPose rel="0"
                mask="4"
                eulers="0;0;0"
                position="0;0;1"/>
      <Sleep msec="5000"/>
      <GoAtWrench mask="32"
                  torque="0;0;-5"
                  force="0;0;0"/>
      <RetryUntilSuccessful num_attempts="-1">
        <Sequence>
          <WaitForFrontVision/>
          <FrontCanSeeObject class="7"/>
          <FrontCanSeeObject class="3" />
        </Sequence>
      </RetryUntilSuccessful>
      <GoAtWrench mask="1"
                  torque="0;0;0"
                  force="10;0;0"/>
      <RepeatUntilSuccessful num_attempts="-1">
        <ForceFailure>
          <OrientTowardsSlalom white_id="7"
                               red_id="3"
                               gate_type="0"
                               shift_force="10"
                               fraction="0.75"/>
        </ForceFailure>
      </RepeatUntilSuccessful>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Startup">
    <Sequence>
      <PrintToLog message="Disarming..."/>
      <SetArmedState flag="0"/>
      <Sleep msec="5000"/>
      <CalibrateSurface/>
      <Sleep msec="1000"/>
      <WaitForPose/>
      <HoldPosition/>
      <Sleep msec="1000"/>
      <PrintToLog message="Arming!"/>
      <SetArmedState flag="1"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="With_Style">
    <Sequence>
      <GoToPose rel="1"
                mask="32"
                eulers="0;0;-45"
                position="0;0;0"/>
      <Sleep msec="2000"/>
      <Repeat num_cycles="8">
        <Sequence>
          <GoToPose rel="1"
                    mask="32"
                    eulers="0;0;90"
                    position="0;0;0"/>
          <Sleep msec="2000"/>
        </Sequence>
      </Repeat>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="CalibrateSurface"/>
    <Condition ID="FrontCanSeeObject">
      <input_port name="class"
                  type="unsigned char"/>
    </Condition>
    <Action ID="GoAtWrench">
      <input_port name="mask"
                  type="unsigned char"/>
      <input_port name="torque"
                  type="geometry_msgs::msg::Vector3_&lt;std::allocator&lt;void&gt; &gt;"/>
      <input_port name="force"
                  type="geometry_msgs::msg::Vector3_&lt;std::allocator&lt;void&gt; &gt;"/>
    </Action>
    <Action ID="GoToPose">
      <input_port name="rel"
                  type="bool"/>
      <input_port name="mask"
                  type="unsigned char"/>
      <input_port name="eulers"
                  type="geometry_msgs::msg::Vector3_&lt;std::allocator&lt;void&gt; &gt;"/>
      <input_port name="position"
                  type="geometry_msgs::msg::Vector3_&lt;std::allocator&lt;void&gt; &gt;"/>
    </Action>
    <Condition ID="FrontHaveSeenObjectSince">
      <input_port name="timeout"
                  type="unsigned int"/>
      <input_port name="class"
                  type="unsigned char"/>
    </Condition>
    <Action ID="HoldPosition"/>
    <Action ID="PrintToLog">
      <input_port name="message"
                  type="std::string"/>
    </Action>
    <Action ID="SetArmedState">
      <input_port name="flag"
                  type="bool"/>
    </Action>
    <Action ID="TurnTowardsObject">
      <input_port name="fraction"
                  type="float"/>
      <input_port name="class"
                  type="unsigned char"/>
    </Action>
    <Action ID="WaitForPose"/>
    <Action ID="WaitForFrontVision"/>
  </TreeNodesModel>

</root>
